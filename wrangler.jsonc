{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "fathy-portfolio",
  // Serves public/ as static files, plus the contact form API in src/worker.js.
  "main": "src/worker.js",
  "compatibility_date": "2026-07-01",
  "routes": [
    { "pattern": "fathyelhadidy.com", "custom_domain": true },
    { "pattern": "www.fathyelhadidy.com", "custom_domain": true }
  ],
  // Kept on so old links to the workers.dev address still redirect.
  "workers_dev": true,
  // The worker runs first on every request so it can redirect www and the
  // old workers.dev address to fathyelhadidy.com — see src/worker.js.
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  // Contact form: at most 5 submissions per minute per IP.
  "ratelimits": [
    {
      "name": "CONTACT_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 5, "period": 60 }
    }
  ],
  // Secrets (RESEND_API_KEY) are set with `npx wrangler secret put`, never here.
  "vars": {
    "RESEND_FROM_EMAIL": "Portfolio <onboarding@resend.dev>",
    "CONTACT_TO_EMAIL": "fathyelhadedy@gmail.com"
  }
}
